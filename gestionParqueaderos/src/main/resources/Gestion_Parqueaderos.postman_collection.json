        {
          "name": "07 - Crear permiso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/permisos"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"zonaId\": \"{{zonaId}}\",\n  \"fechaInicio\": \"{{fechaInicio}}\",\n  \"fechaFin\": \"{{fechaFin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date();",
                  "const fin = new Date(hoy);",
                  "fin.setDate(fin.getDate() + 30);",
                  "const iso = d => {",
                  "  const y = d.getFullYear();",
                  "  const m = String(d.getMonth()+1).padStart(2,'0');",
                  "  const day = String(d.getDate()).padStart(2,'0');",
                  "  return `${y}-${m}-${day}`;",
                  "};",
                  "pm.collectionVariables.set(\"fechaInicio\", iso(hoy));",
                  "pm.collectionVariables.set(\"fechaFin\", iso(fin));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Permiso creado (201)\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"permisoId\", data.id);"
                ]
              }
            }
          ]
